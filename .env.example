# Copy to .env (never commit .env). All keys below have free tiers.
GROQ_API_KEY=
GEMINI_API_KEY=
TAVILY_API_KEY=            # optional: live hotel search (without it, typical regional prices are used and labelled)

TRIPMATE_ENV=development
# Dev default is SQLite + in-memory checkpoints. For the real stack use docker compose, or set:
# TRIPMATE_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tripmate
# TRIPMATE_CHECKPOINT_POSTGRES_URL=postgresql://user:pass@localhost:5432/tripmate
# TRIPMATE_REDIS_URL=redis://localhost:6379/0
# TRIPMATE_QUEUE_BACKEND=arq
# Production requires a real secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
# TRIPMATE_JWT_SECRET=

# Optional observability
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# SENTRY_DSN=
